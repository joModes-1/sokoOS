# ── Database ──────────────────────────────────────────────────
DATABASE_URL="postgresql://sokoos:password@localhost:5432/sokoos"
DIRECT_URL="postgresql://sokoos:password@localhost:5432/sokoos"

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ───────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="change-me-in-production-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="30d"
BCRYPT_ROUNDS=12

# ── MTN MoMo ───────────────────────────────────────────────────
MTN_MOMO_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_ENVIRONMENT="sandbox"

# ── Airtel Money ───────────────────────────────────────────────
AIRTEL_MONEY_BASE_URL="https://openapi.airtel.africa"
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
AIRTEL_MONEY_ENVIRONMENT="sandbox"

# ── Object Storage (S3-compatible) ────────────────────────────
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="sokoos-uploads"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL="https://sokoos-uploads.s3.amazonaws.com"

# ── SMS / WhatsApp ─────────────────────────────────────────────
# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SokoOS <no-reply@example.com>"
SUPPORT_EMAIL="support@example.com"

# ── SMS / WhatsApp ─────────────────────────────────────────────
SMS_PROVIDER="mock"
WHATSAPP_PROVIDER="mock"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""

# ── App ────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"

# ── Frontend (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
